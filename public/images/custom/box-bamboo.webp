<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <radialGradient id="grad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#7D5836;stop-opacity:0.85" />
      <stop offset="100%" style="stop-color:#152018;stop-opacity:1" />
    </radialGradient>
    <pattern id="grain" width="40" height="40" patternUnits="userSpaceOnUse">
      <circle cx="20" cy="20" r="1" fill="#B9955A" opacity="0.15"/>
    </pattern>
  </defs>
  <rect width="800" height="600" fill="url(#grad)" />
  <rect width="800" height="600" fill="url(#grain)" />
  <rect x="40" y="40" width="720" height="520" rx="16" fill="none" stroke="#B9955A" stroke-width="1.5" stroke-dasharray="8 8" opacity="0.4"/>
  <circle cx="400" cy="240" r="64" fill="#7D5836" stroke="#B9955A" stroke-width="2"/>
  <text x="400" y="252" font-family="serif" font-size="36" fill="#B9955A" text-anchor="middle" font-weight="bold">✦</text>
  <text x="400" y="350" font-family="serif" font-size="28" fill="#FFFDF8" text-anchor="middle" font-weight="bold">Hộp Mây Tre Đan Tay</text>
  <text x="400" y="390" font-family="sans-serif" font-size="14" fill="#B9955A" text-anchor="middle" letter-spacing="3" text-transform="uppercase">Làng Nghề Truyền Thống</text>
  <text x="400" y="440" font-family="serif" font-size="12" fill="#FFFDF8" opacity="0.5" text-anchor="middle">VÙNG QUÊ — GỬI TRỌN HƯƠNG VỊ VIỆT</text>
</svg>